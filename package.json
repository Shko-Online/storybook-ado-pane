{
  "name": "storybook-ado-pane",
  "version": "0.0.0-semantic-release",
  "private": true,
  "description": "Azure DevOps extension: publish a Storybook from your pipeline and browse it in a tab of the run.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/sw/tsconfig.json && tsc -p tasks/PublishStorybook/tsconfig.json && tsc -p test/tsconfig.json",
    "test": "node scripts/test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "dev": "node scripts/build.mjs --dev && node scripts/dev-server.mjs",
    "storybook": "node scripts/build.mjs --web-only && storybook dev -p 6007",
    "build-storybook": "node scripts/build.mjs --web-only && storybook build -o build/storybook",
    "capture-run": "node scripts/capture-run.mjs --org Shko-Online --project Shko.Online",
    "package": "node scripts/package.mjs",
    "package:dev": "node scripts/package.mjs --dev",
    "publish:dev": "node scripts/release/dev.mjs --org Shko-Online",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.11",
    "@storybook/html": "^10.6.7",
    "@storybook/html-vite": "^10.6.7",
    "azure-devops-extension-api": "^5.280.1",
    "azure-devops-extension-sdk": "^4.2.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "semantic-release": "^26.0.1",
    "storybook": "^10.6.5",
    "tfx-cli": "^0.24.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.14"
  }
}
